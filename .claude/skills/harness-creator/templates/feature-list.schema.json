{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature List & Cross-Machine Active Context",
  "description": "Track feature implementation state and portable cross-machine handoff context for agent-driven development",
  "type": "object",
  "properties": {
    "active_context": {
      "type": "object",
      "description": "Lightweight git-tracked handoff summary so switching PCs without syncing ai-memory retains the active objective, blockers, and next step",
      "properties": {
        "current_feature_id": {
          "type": "string",
          "description": "ID of the feature currently in progress (e.g., feat-001)"
        },
        "last_updated": {
          "type": "string",
          "description": "ISO date or timestamp of the last session update"
        },
        "summary": {
          "type": "string",
          "description": "Brief summary of current progress and key decisions"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Open blockers or unresolved questions"
        },
        "next_step": {
          "type": "string",
          "description": "Exact next action for the next session or machine"
        }
      },
      "required": ["current_feature_id", "summary", "blockers", "next_step"]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique feature identifier (e.g., feat-001)",
            "pattern": "^feat-\\d+$"
          },
          "name": {
            "type": "string",
            "description": "Short feature name"
          },
          "description": {
            "type": "string",
            "description": "What this feature does"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Feature IDs that must be done before this one"
          },
          "status": {
            "type": "string",
            "enum": ["not-started", "in-progress", "blocked", "done"],
            "description": "Current implementation state"
          },
          "evidence": {
            "type": "string",
            "description": "Verification evidence when status is 'done'"
          }
        },
        "required": ["id", "name", "description", "status"]
      }
    }
  },
  "required": ["active_context", "features"]
}
